enum FileStorage {
  PUBLIC
  LOCAL
  S3
}

enum FileAccess {
  PRIVATE
  PUBLIC
}

model FileAsset {
  id           String      @id @default(uuid())
  storage      FileStorage
  objectKey    String      @unique
  originalName String
  mimeType     String
  byteSize     Int
  createdById  String?
  createdAt    DateTime    @default(now())

  createdBy  User?           @relation("FileCreator", fields: [createdById], references: [id], onDelete: SetNull)
  references FileReference[]

  @@index([createdById, createdAt])
}

model FileReference {
  id                        String     @id @default(uuid())
  fileId                    String
  access                    FileAccess @default(PRIVATE)
  newsRevisionFileId        String?    @unique
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  file                    FileAsset                @relation(fields: [fileId], references: [id], onDelete: Restrict)
  newsRevisionFile        NewsRevisionFile?        @relation(fields: [newsRevisionFileId], references: [id], onDelete: Cascade)

  @@index([fileId, access])
}
