{
  "name": "@project-forge/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 5051",
    "build": "next build",
    "start": "next start --port 5051",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint \"src/admin/**/*.{ts,tsx}\" \"src/app/admin/**/*.{ts,tsx}\" \"src/servers/**/*.{ts,tsx}\" \"src/hooks/**/*.{ts,tsx}\" \"src/lib/**/*.{ts,tsx}\"",
    "knip": "knip",
    "check:ui-i18n": "node scripts/check-ui-i18n.mjs",
    "check:admin-client-boundary": "node scripts/check-admin-client-boundary.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "db:pushf": "prisma db push --force-reset",
    "db:seed": "prisma db seed",
    "db:seed:default": "tsx prisma/seed/default-seed.ts",
    "db:seed:mockup": "tsx prisma/seed/mockup-seed.ts",
    "db:seed:categories": "tsx prisma/seed/default/categories-seed.ts",
    "db:seed:users": "tsx prisma/seed/default/users-seed.ts",
    "db:seed:mockup:news": "tsx prisma/seed/mockup/news-seed.ts"
  },
  "knip": {
    "entry": [
      "bun-tests/vitest.test.ts"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@mantine/core": "^9.4.2",
    "@mantine/dates": "^9.4.2",
    "@mantine/form": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@mantine/modals": "^9.4.2",
    "@mantine/notifications": "^9.4.2",
    "@mantine/tiptap": "^9.4.2",
    "@prisma/client": "^6.19.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@tabler/icons-react": "^3.46.0",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/extension-text-style": "3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "dotenv": "^16.6.1",
    "mantine-datatable": "^9.4.0",
    "next": "^16.3.0",
    "next-intl": "^4.14.2",
    "next-safe-action": "^8.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "^9.3.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "knip": "^6.32.2",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
