DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app-db?schema=public"
AUTH_SECRET="replace-with-a-random-secret # generate: openssl rand -base64 32"

# Auth.js (NextAuth v5) — MUST match the public origin.
# If not set, Auth.js infers the origin from the Host header. Behind nginx
# `proxy_pass http://localhost:3000` without `proxy_set_header Host $host`
# the inferred origin becomes http://localhost:3000 -> callback POST fails.
AUTH_URL="http://localhost:3000"
# Legacy alias (NextAuth v4 compat) — Auth.js v5 prefers AUTH_URL, but some
# tools still read NEXTAUTH_URL. Keep both in sync for production.
# NEXTAUTH_URL="http://localhost:3000"
# `trustHost: true` is already set in src/auth.ts:66, so X-Forwarded-* headers
# are respected when AUTH_URL is not set, but setting AUTH_URL explicitly is
# the most robust option for self-host behind a reverse proxy.

# File Manager storage: local for development, s3 for object storage deployments
FILE_MANAGER_STORAGE="local"
FILE_MANAGER_LOCAL_ROOT=".data/files"
# Permanently delete a stored file once no live record uses it any more. Applies
FILE_MANAGER_DELETE_ON_REMOVE="true"
# FILE_MANAGER_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# FILE_MANAGER_S3_REGION="auto"
# FILE_MANAGER_S3_BUCKET="app-name-files"
# FILE_MANAGER_S3_ACCESS_KEY_ID=""
# FILE_MANAGER_S3_SECRET_ACCESS_KEY=""
# FILE_MANAGER_S3_FORCE_PATH_STYLE="false"
